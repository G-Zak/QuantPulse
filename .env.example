# Copy to .env and fill in. .env is gitignored.
#
# Drahmi API — https://drahmi.app/api
# FREE TIER: 100 requests per DAY, reset 00:00 UTC. Treat every call as expensive.
# Development and tests must run against recorded fixtures (ops/fixtures/), never this key.
DRAHMI_API_KEY=drahmi_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DRAHMI_BASE_URL=https://api.drahmi.app/api/v1

# Alpha Vantage — https://www.alphavantage.co/documentation/
# FREE TIER: 25 requests per DAY. Used only for FX (USD/MAD, EUR/MAD) and global
# benchmarks; it does not cover the Casablanca exchange. Only the `live` profile uses it;
# dev and tests replay ops/fixtures/av-*.json.
ALPHA_API_KEY=your_alpha_vantage_key

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quantpulse
POSTGRES_ADMIN_USER=quantpulse
POSTGRES_ADMIN_PASSWORD=change_me_local_only

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=quantpulse
RABBITMQ_PASSWORD=change_me_local_only

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Grafana
GRAFANA_ADMIN_PASSWORD=change_me_local_only

# AI market brief (qp-insights). Optional, leave empty to use the template brief.
# INSIGHTS_DAILY_LIMIT caps model calls per day, regenerations included.
ANTHROPIC_API_KEY=
INSIGHTS_MODEL=claude-sonnet-5
INSIGHTS_DAILY_LIMIT=5
