<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.quantpulse</groupId>
        <artifactId>quantpulse-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>qp-common</artifactId>
    <name>qp-common</name>
    <description>Shared event contracts and value types. Deliberately framework-light.</description>

    <!--
      This module is a plain library, NOT a Spring Boot application:
      no spring-boot-maven-plugin, so it produces an ordinary jar that the
      services can put on their classpath. A Boot "fat jar" cannot be used
      as a dependency, which is a common multi-module trap.

      It also has no Spring dependency at all. Event contracts shared between
      services should not drag a framework across a service boundary — if
      qp-portfolio and qp-marketdata are ever on different Spring versions,
      the contract must still compile.
    -->

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
